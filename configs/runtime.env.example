# Reference only: show_runtime_info.py does not read or source this file.
# Set the profile explicitly in your shell or pass --profile to the script.
# A100 example (RTX5090 requires profile rtx5090 and CUDA_VISIBLE_DEVICES=1):
NEUROBUILD_PROFILE=a100
CUDA_VISIBLE_DEVICES=3

# Localhost placeholders; these settings do not start any service.
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
MODEL_SERVER_URL=http://localhost:8003

# No model selected in Phase 0. Empty means unset.
NEUROBUILD_MODEL_ID=
